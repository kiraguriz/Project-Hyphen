<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN sockets for discovery probes and mutual-TLS transport (ADR-0003 §6). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Scoped MulticastLock during discovery windows only (ADR-0003 §6,
         HYP-M1-005). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- User-visible Android foreground work (ADR-0003 §3). The connection
         and user-initiated transfer services are separate so dataSync can
         terminate independently at completion/timeout. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Self-managed CDM association, API 33+ (ADR-0003 §6, HYP-M1-007). -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_SELF_MANAGED" />

    <!-- Package visibility (Android 11+): without this declaration
         resolveActivity() returns null for the system camera even when one is
         installed, so the dependency-free QR handoff would always fall back to
         paste. No camera permission is requested; this only lets the app see
         which app handles the still-image camera action. -->
    <queries>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- allowBackup=false: trust-store material must never enter device
         backups (threat model §3.3); keys are non-portable by design. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Dependency-free QR journey: the system camera/browser opens
                 the protocol's custom pairing URI; MainActivity still parses
                 and validates the entire payload before any network action. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hyphen" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.HyphenConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <service
            android:name=".service.HyphenTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Android notification mirror entry point (HYP-M3-001).
             The user must enable this service explicitly in system settings;
             payload normalization and forwarding land in HYP-M3-002/003. -->
        <service
            android:name=".notifications.HyphenNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
