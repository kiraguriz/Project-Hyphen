    <string name="perm_qr_title">Scan with system camera</string>
    <string name="perm_qr_detail">Scan the Mac\'s Hyphen QR with the system camera; its pairing link returns here for validation.</string>
    <string name="perm_btn_qr_help">How to scan</string>
    <string name="dlg_qr_help_title">Scan the QR code on your Mac</string>
    <string name="dlg_qr_help_msg">1. Open “Pair new device” from the Hyphen menu on your Mac.\n2. Scan its QR code with the Android system camera.\n3. Open the hyphen://pair link to return here.\n4. Trust only when both devices show the same pairing code.\n\nThis path does not give Hyphen camera access or add a third-party scanner SDK.</string>
    <string name="dlg_companion_title">Keep the Mac connected?</string>
    <string name="dlg_companion_msg">Hyphen will run a connectedDevice foreground service with an always-visible notification. It communicates only with the paired Mac over LAN TLS—no cloud relay or telemetry. Disconnect any time from the notification or this screen.</string>
    <string name="dlg_companion_enable">Enable with notification</string>
    <string name="dlg_companion_requires_peer_msg">The background companion link can only connect to a Mac already verified by QR or SAS. Complete pairing first.</string>
    <string name="dlg_companion_settings_title">Companion notification is not visible</string>
    <string name="dlg_companion_settings_msg">For transparency, Hyphen will not keep a background link when its notification is hidden. Allow Hyphen notifications in system settings, then try again.</string>
    <string name="dlg_open_app_notification_settings">Open notification settings</string>
    <string name="dlg_discovery_none_title">No Mac found</string>
    <string name="dlg_discovery_none_msg">This LAN discovery window found nothing. You can still scan the pairing QR with the system camera, or paste the address and nonce shown on the Mac pairing screen.</string>
    <string name="dlg_discovery_found_title">Found %1$d Mac(s)</string>
    <string name="dlg_discovery_found_msg">%1$s\n\nDiscovery results are LAN hints, not trust credentials. Open Hyphen\'s pairing screen on one of these Macs and scan its QR code.</string>
    <string name="dlg_transfer_notification_title">Show transfer status?</string>
    <string name="dlg_transfer_notification_msg">Choosing a file temporarily leaves Hyphen. To avoid a hidden background link, Hyphen first enables the visible companion-link notification and shows a dataSync notification while sending. The companion link stays on until you disconnect from the notification or this screen.</string>
    <string name="dlg_transfer_notification_continue">Allow and choose file</string>
    <string name="dlg_privacy_floor_title">Phone privacy floor</string>
    <string name="dlg_privacy_floor_msg">The Mac may choose a stricter mode for an app, but it cannot loosen this setting. Notification history is not stored.</string>
    <string name="dlg_privacy_apply">Apply</string>
