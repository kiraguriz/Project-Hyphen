    <!-- Dialogs: notification onboarding -->
    <string name="dlg_notif_onboard_title">开启通知镜像</string>
    <string name="dlg_notif_onboard_msg">Hyphen 可以读取 Android 通知的标题、操作和内容，并通过局域网 TLS 将它们镜像到已配对的 Mac。\n\n通知不会发送到云端中继，Hyphen 也不保存通知历史。开启后，如果希望 Mac 上显示更少的细节，可以切换到隐藏内容模式。\n\nHyphen 从不请求短信或通话记录权限。你之后可以在 Android 设置中关闭通知使用权。</string>
    <string name="dlg_notif_open_settings">打开设置</string>
